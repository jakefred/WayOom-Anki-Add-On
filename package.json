  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/mistral": "4.0.76",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/xai": "5.0.34",
    "ai": "7.0.158",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
